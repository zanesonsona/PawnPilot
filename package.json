{
  "name": "pawnpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant pawnshop management SaaS for the Philippine market",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @pawnpilot/api",
    "dev:web": "npm run dev -w @pawnpilot/web",
    "build": "npm run build -w @pawnpilot/api && npm run build -w @pawnpilot/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @pawnpilot/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "npm run prisma:generate -w @pawnpilot/api",
    "db:migrate": "npm run prisma:migrate -w @pawnpilot/api",
    "db:deploy": "npm run prisma:deploy -w @pawnpilot/api",
    "db:seed": "npm run prisma:seed -w @pawnpilot/api",
    "openapi:generate": "npm run generate -w @pawnpilot/api-client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "@scarf/scarf": false
  }
}
