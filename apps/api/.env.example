# Copy to .env for local API and Prisma commands.
# Never commit real credentials.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://pawnpilot:pawnpilot_dev@localhost:5432/pawnpilot?schema=public
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
SESSION_TTL_HOURS=12
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30

# Optional local seed credentials. Never use these values in production.
# PLATFORM_ADMIN_EMAIL=admin@example.com
# PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
# PLATFORM_ADMIN_DISPLAY_NAME=Platform Administrator
